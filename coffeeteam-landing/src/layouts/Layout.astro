---
import '../styles/global.css';
import { FONT_URL, BOJE } from '../brand';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Coffee Team — Servis espresso aparata | Podgorica',
  description = 'Coffee Team — ovlašteni servis espresso aparata, mlinova i profesionalne kafe opreme u Podgorici i Crnoj Gori. Servis · Kafa · Oprema.',
} = Astro.props;
---

<!doctype html>
<html lang="sr-Latn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content={BOJE.povrsina} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={FONT_URL} rel="stylesheet" />
  </head>
  <body class="bg-ct-pozadina text-ct-tekst font-sans antialiased">
    <slot />
  </body>
</html>
